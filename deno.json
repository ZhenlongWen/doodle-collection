{
    "compilerOptions": {
        "lib": ["deno.window", "dom"]
    },
    "tasks": {
        "start": "DENO_ENV=production deno run -A src/server/main.ts",
        "build": "cd frontend && npm run build",
        "dev:client": "cd frontend && npm run dev",
        "dev:server": "DENO_ENV=development deno run -A --watch src/server/main.ts",
        "dev": "npm run dev"
    }
}
